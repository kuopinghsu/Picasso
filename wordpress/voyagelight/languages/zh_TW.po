msgstr "讀取為 %s"

#: functions.php:318 functions.php:607
msgid "No location set."
msgstr "尚未設定位置。"

#: functions.php:322
msgid ""
"Short links such as maps.app.goo.gl can’t be read here: open the link, then "
"copy the full address from the browser’s address bar."
