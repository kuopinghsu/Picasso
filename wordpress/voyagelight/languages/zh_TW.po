#: inc/locations.php
msgid "There is no location."
msgstr "沒有填寫位置。"

#: inc/locations.php
msgid "Short links can’t be read without opening them. Open the link, then copy the full address from the browser’s address bar."
msgstr "短網址必須開啟後才能讀取。請先開啟連結，再從瀏覽器網址列複製完整網址。"

#: inc/locations.php
msgid "This link has no coordinates in it. Open the place on the map, then copy the address again."
msgstr "這個連結裡沒有座標。請在地圖上開啟該地點，再重新複製網址。"

#: inc/locations.php
msgid "Out of range: latitude goes from -90 to 90 and longitude from -180 to 180."
msgstr "超出範圍：緯度須介於 -90 到 90，經度須介於 -180 到 180。"

#: inc/locations.php
msgid "This is not a location the theme can read."
msgstr "佈景主題無法讀取這個位置。"

#: inc/locations.php
msgid "The place name is missing."
msgstr "缺少地點名稱。"

#. translators: %d: highest day number.
#: inc/locations.php
#, php-format
msgid "The day must be a number from 1 to %d."
msgstr "天數必須是 1 到 %d 的數字。"

#: inc/locations.php
msgid "The map loads its tiles from OpenStreetMap, which sees your IP address."
msgstr "地圖會從 OpenStreetMap 載入圖磚，該服務會看到你的 IP 位址。"

#: inc/locations.php
msgid "Find a place"
msgstr "搜尋地點"

#: inc/locations.php
#: searchform.php
msgid "Search"
msgstr "搜尋"

#: inc/locations.php
msgid "Search by OpenStreetMap Nominatim"
msgstr "搜尋服務由 OpenStreetMap Nominatim 提供"

#: inc/locations.php
msgid "Pressing Search sends what you typed to it."
msgstr "按下「搜尋」會把你輸入的文字傳送給這項服務。"

#: inc/locations.php
msgid "A click on the map"
msgstr "在地圖上點一下會"

#: inc/locations.php
