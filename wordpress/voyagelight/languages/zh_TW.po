#: functions.php:306
msgid ""
"Paste coordinates or a map link, such as 39.8628, -4.0273 or 39°51′46″N "
"4°01′38″W. Links from Google Maps, Apple Maps and OpenStreetMap and geo: "
"addresses work too. Leave it empty for no location."
msgstr ""
"貼上座標或地圖連結，例如 39.8628, -4.0273 或 39°51′46″N 4°01′38″W。也可以使"
"用 Google 地圖、Apple 地圖、OpenStreetMap 的連結和 geo: 位址。留空表示不設定"
"位置。"

#. translators: 1: the location as typed, 2: why it couldn't be read.
#: functions.php:311 functions.php:617
#, php-format
msgid "The location “%1$s” couldn’t be read: %2$s The saved location was kept."
msgstr "無法讀取位置「%1$s」：%2$s 已保留原本儲存的位置。"

